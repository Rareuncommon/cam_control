# --- Sony Camera Remote SDK -------------------------------------------------
# The SDK is licensed per-developer and must not be redistributed. Everything
# under vendor/CrSDK/ is ignored except the placement instructions.
vendor/CrSDK/*
!vendor/CrSDK/README.md

# Sony's RemoteCli sample, unpacked for Phase 0
vendor/RemoteCli/

# --- Real config (contains camera credentials) ------------------------------
config/cambridge.json
config/*.local.json

# Presets, scenes and gangs the operator saves at runtime. Per-installation
# state, not source — and it is written by the app, so tracking it would show a
# dirty tree after every service.
config/cambridge-presets.json

# --- Build output -----------------------------------------------------------
build/
camd/build/
*.o
*.dylib
*.so
*.a
.cache/
compile_commands.json

# --- Node -------------------------------------------------------------------
# cambridge itself has no dependencies. The Companion module is the exception:
# it must build against Bitfocus's SDK, which is installed with `npm install`
# in companion-module-cambridge/ and never committed.
node_modules/
npm-debug.log*
.npm/
package-lock.json

# --- Logs / runtime ---------------------------------------------------------
logs/
*.log
run/
*.pid

# --- macOS / editors --------------------------------------------------------
.DS_Store
.vscode/
.idea/
*.swp

# Generated macOS app bundle
CamBridge.app/
